# Local development template. Copy to .env; the real .env is ignored by Git and Docker builds.

# Spring Boot / MySQL
SERVER_PORT=8081
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=anshun_ad_db
DB_USERNAME=root
DB_PASSWORD=change-me-in-production

# Redis authentication state, cache and rate limits
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
CACHE_TYPE=redis
TOKEN_BLACKLIST_ENABLED=true
TOKEN_BLACKLIST_FAIL_CLOSED=false
LOGIN_RATE_LIMIT_REDIS_ENABLED=true

# MinIO
MINIO_ENDPOINT=http://127.0.0.1:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin-change-me
MINIO_BUCKET=lease-attachments

# Qdrant and embeddings. Hash mode is an offline development fallback, not semantic embedding.
VECTOR_STORE_ENABLED=true
QDRANT_BASE_URL=http://127.0.0.1:6333
AI_EMBEDDING_PROVIDER=hash
AI_EMBEDDING_MODEL=local-hash-ngram-v1
AI_EMBEDDING_DIMENSIONS=256
QDRANT_VECTOR_DIMENSIONS=256
# AI_EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
# AI_EMBEDDING_API_KEY=

# DeepSeek-compatible chat API. Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BYPASS_SYSTEM_PROXY=false

# Production example (set every secret explicitly before enabling):
# SPRING_PROFILES_ACTIVE=prod
# JWT_SECRET=<base64-encoded-random-secret-at-least-32-bytes>
# BOOTSTRAP_ADMIN_PASSWORD=<first-boot-admin-password-at-least-12-chars>
# DB_PASSWORD=<non-demo-database-password>
# MINIO_SECRET_KEY=<non-demo-storage-password>
# REGISTRATION_ENABLED=false
# TOKEN_BLACKLIST_FAIL_CLOSED=true
